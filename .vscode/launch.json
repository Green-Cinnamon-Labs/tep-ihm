{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "IHM: planta local (plant OPC-UA)",
            "type": "debugpy",
            "request": "launch",
            "module": "src.server",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "OPCUA_ENDPOINT": "opc.tcp://127.0.0.1:4840/tep/server/",
                "PORT": "8080",
                "K8S_ENABLED": "false"
            }
        },
        {
            "name": "IHM: planta local (plant OPC-UA + k8s)",
            "type": "debugpy",
            "request": "launch",
            "module": "src.server",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "OPCUA_ENDPOINT": "opc.tcp://127.0.0.1:4840/tep/server/",
                "PORT": "8080",
                "K8S_ENABLED": "true",
                "K8S_SERVER": "https://127.0.0.1:6443"
            }
        },
        {
            "name": "IHM: replay CSV (sem planta)",
            "type": "debugpy",
            "request": "launch",
            "module": "src.server",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "CSV_REPLAY": "${workspaceFolder}/../tep-plant/docs/csvs/simulation_log_13.csv",
                "PORT": "8080",
                "K8S_ENABLED": "false",
            }
        }
    ]
}
